# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# --- Database ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- GitHub OAuth App (https://github.com/settings/developers) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# --- Sessions ---
# Random secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Frontend / cookies ---
FRONTEND_URL=https://hgu.app
API_PUBLIC_URL=https://api.hgu.app
COOKIE_DOMAIN=.hgu.app
COOKIE_SECURE=true

# --- Deployment host ---
PUBLIC_DOMAIN=hgu.app
SERVER_HOST=

# --- Nginx Proxy Manager (proxy hosts + optional auto SSL) ---
NPM_API_URL=
NPM_EMAIL=
NPM_PASSWORD=
AUTO_SSL_ENABLED=false

# --- Limits (optional, defaults shown) ---
MAX_CONCURRENT_DEPLOYMENTS_PER_USER=5
DEPLOY_MEM_LIMIT=512m
DEPLOY_CPU_LIMIT=1
DEPLOY_BUILD_MEM_LIMIT=3g
DEPLOY_BUILD_CPU_LIMIT=2
