const express = require('express');
const jwt = require('jsonwebtoken');
const axios = require('axios');
const cors = require('cors');
const { exec } = require('child_process');
const mysql = require('mysql2/promise');

require('dotenv').config();

const app = express();

app.use(cors());
app.use(express.json());

const deploymentLogs = {};

const pool = mysql.createPool({
    host: process.env.DB_HOST,
    port: process.env.DB_PORT,
    user: process.env.DB_USER,
    password: process.env.DB_PASSWORD,
    database: process.env.DB_NAME
});

app.get('/', (req, res) => {

    res.send('Backend Server Running');
});

app.get('/auth/github', (req, res) => {

    const redirectUri =
        'https://github.com/login/oauth/authorize'
        + `?client_id=${process.env.GITHUB_CLIENT_ID}`;

    res.redirect(redirectUri);
});

app.get('/auth/github/callback', async (req, res) => {

    const code = req.query.code;

    try {

        const tokenResponse = await axios.post(
            'https://github.com/login/oauth/access_token',
            {
                client_id: process.env.GITHUB_CLIENT_ID,
                client_secret: process.env.GITHUB_CLIENT_SECRET,
                code
            },
            {
                headers: {
                    Accept: 'application/json'
                }
            }
        );

        const accessToken =
            tokenResponse.data.access_token;

        const userResponse = await axios.get(
            'https://api.github.com/user',
            {
                headers: {
                    Authorization: `Bearer ${accessToken}`
                }
            }
        );

        const user = userResponse.data;

        const token = jwt.sign(
            {
                id: user.id,
                username: user.login,
                github_access_token: accessToken
            },
            process.env.JWT_SECRET,
            {
                expiresIn: '1d'
            }
        );

        res.redirect(
            `https://hgu.app/dashboard?token=${token}`
        );

    } catch (error) {

        console.error(error);

        res.status(500).json({
            error: 'GitHub OAuth Failed'
        });
    }
});

app.get('/repositories', async (req, res) => {

    try {

        const authHeader = req.headers.authorization;

        if (!authHeader) {

            return res.status(401).json({
                error: 'No token'
            });
        }

        const token = authHeader.split(' ')[1];

        const decoded = jwt.verify(
            token,
            process.env.JWT_SECRET
        );

        const githubToken =
            decoded.github_access_token;

        const response = await axios.get(
            'https://api.github.com/user/repos',
            {
                headers: {
                    Authorization:
                        `Bearer ${githubToken}`
                }
            }
        );

        res.json(response.data);

    } catch (error) {

        console.error(error);

        res.status(500).json({
            error: 'Failed to fetch repositories'
        });
    }
});

app.post('/projects', async (req, res) => {

    try {

        console.log('DEPLOY START');

        const {
            name,
            repository,
            branch,
            serviceType
        } = req.body;

        const projectName = name;

        deploymentLogs[projectName] = [];

        deploymentLogs[projectName].push(
            '🚀 Deployment started'
        );

        const authHeader = req.headers.authorization;

        const token = authHeader.split(' ')[1];

        const decoded = jwt.verify(
            token,
            process.env.JWT_SECRET
        );

        const githubToken =
            decoded.github_access_token;

        const githubUsername =
            decoded.username;

        const [rows] = await pool.execute(
            'SELECT MAX(port) as maxPort FROM deployments'
        );

        const port =
            rows[0].maxPort
                ? rows[0].maxPort + 1
                : 3010;

        console.log('ALLOCATED PORT:', port);

        const deploymentId = Date.now();

        const projectPath =
            `/tmp/deployments/${projectName}-${deploymentId}`;

        const imageName =
            `deploy-${deploymentId}`;

        const containerName =
            `container-${deploymentId}`;

        deploymentLogs[projectName].push(
            '📦 Cloning repository...'
        );

        const cloneCommand =
            `git clone --branch ${branch} `
            + `https://${githubToken}@github.com/`
            + `${githubUsername}/${repository}.git `
            + `${projectPath}`;

        console.log(cloneCommand);

        exec(cloneCommand, (cloneError) => {

            if (cloneError) {

                console.error(cloneError);

                deploymentLogs[projectName].push(
                    '❌ Git clone failed'
                );

                return res.status(500).json({
                    error: 'Git clone failed'
                });
            }

            console.log('CLONE SUCCESS');

            deploymentLogs[projectName].push(
                '✅ Repository cloned'
            );

            deploymentLogs[projectName].push(
                '🔨 Building Docker image...'
            );

            const buildCommand =
                `docker build -t ${imageName} ${projectPath}`;

            console.log(buildCommand);

            exec(buildCommand, async (buildError) => {

                if (buildError) {

                    console.error(buildError);

                    deploymentLogs[projectName].push(
                        '❌ Docker build failed'
                    );

                    return res.status(500).json({
                        error: 'Docker build failed'
                    });
                }

                console.log('BUILD SUCCESS');

                deploymentLogs[projectName].push(
                    '✅ Docker build complete'
                );

                deploymentLogs[projectName].push(
                    '🐳 Starting container...'
                );

                const runCommand =
                    `docker run -d `
                    + `--name ${containerName} `
                    + `-p ${port}:80 `
                    + `${imageName}`;

                console.log(runCommand);

                exec(runCommand, async (runError) => {

                    if (runError) {

                        console.error(runError);

                        deploymentLogs[projectName].push(
                            '❌ Container start failed'
                        );

                        return res.status(500).json({
                            error: 'Container start failed'
                        });
                    }

                    console.log('RUN SUCCESS');

                    deploymentLogs[projectName].push(
                        '✅ Container started'
                    );

                    const url =
                        `http://192.168.0.11:${port}`;

                    await pool.execute(
                        `
                        INSERT INTO deployments
                        (
                            project_name,
                            repository_name,
                            container_name,
                            image_name,
                            port,
                            url,
                            status
                        )
                        VALUES (?, ?, ?, ?, ?, ?, ?)
                        `,
                        [
                            projectName,
                            repository,
                            containerName,
                            imageName,
                            port,
                            url,
                            'running'
                        ]
                    );

                    console.log('DB SAVE SUCCESS');

                    deploymentLogs[projectName].push(
                        '✅ Deployment completed'
                    );

                    res.json({
                        success: true,
                        url
                    });
                });
            });
        });

    } catch (error) {

        console.error(error);

        res.status(500).json({
            error: 'Deployment failed'
        });
    }
});

app.get('/deployments', async (req, res) => {

    try {

        const [rows] = await pool.execute(
            `
            SELECT *
            FROM deployments
            ORDER BY created_at DESC
            `
        );

        res.json(rows);

    } catch (error) {

        console.error(error);

        res.status(500).json({
            error: 'Failed to fetch deployments'
        });
    }
});

app.get('/deployments/:name/logs', (req, res) => {

    const projectName = req.params.name;

    res.json(
        deploymentLogs[projectName] || []
    );
});

app.post('/deployments/:id/stop', async (req, res) => {

    try {

        const deploymentId = req.params.id;

        const [rows] = await pool.execute(
            'SELECT * FROM deployments WHERE id = ?',
            [deploymentId]
        );

        if (rows.length === 0) {

            return res.status(404).json({
                error: 'Deployment not found'
            });
        }

        const deployment = rows[0];

        exec(
            `docker stop ${deployment.container_name}`,
            async (error) => {

                if (error) {

                    console.error(error);

                    return res.status(500).json({
                        error: 'Failed to stop container'
                    });
                }

                await pool.execute(
                    `
                    UPDATE deployments
                    SET status = 'stopped'
                    WHERE id = ?
                    `,
                    [deploymentId]
                );

                res.json({
                    success: true
                });
            }
        );

    } catch (error) {

        console.error(error);

        res.status(500).json({
            error: 'Internal Server Error'
        });
    }
});

